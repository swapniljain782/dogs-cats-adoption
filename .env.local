# Local MLflow configuration
# Source this file: source .env.local
# Or copy to .env and use python-dotenv

# MLflow tracking - use local file store (no server needed)
# MLFLOW_TRACKING_URI=file:./mlruns

# MLflow tracking - use local server (run: docker compose -f deployment/mlflow/docker-compose.yml up -d)
MLFLOW_TRACKING_URI=http://localhost:5000

# MinIO/S3 artifact store (for local server)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_S3_IGNORE_TLS=true
AWS_ACCESS_KEY_ID=mlflow
AWS_SECRET_ACCESS_KEY=mlflow123

# For training script
POSTGRES_PASSWORD=mlflow123